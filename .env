# MN Dramas — Environment Variables
# Copy this to .env.local when deploying to Vercel (Vercel → Project Settings → Env Vars)

# Optional: override the upstream source (defaults to https://kisskh.co)
 KISSKH_BASE_URL=https://kisskh.co

# Optional: a pre-generated kkey token for the stream endpoint.
# If set, the /api/watch endpoint will include it in the upstream request.
# KISSKH_STREAM_KEY=

# Optional: a pre-generated kkey token for subtitles.
# KISSKH_SUB_KEY=

# Public base URL of your deployed API (used by the frontend in dev)
# VITE_API_BASE=/api
